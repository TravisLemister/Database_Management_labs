  Part A:
1. 
EXPLAIN
SELECT *
FROM Enrollments
WHERE term = 'Spring 2026' AND course_id = '503';

2.
EXPLAIN
SELECT *
FROM Enrollments
WHERE term = 'Spring 2026' AND student_id = 1001;

3. 
EXPLAIN
SELECT s.name, c.title, e.term
FROM Students s
JOIN Enrollments e ON s.student_id = e.student_id
JOIN Courses c ON c.course_id = e.course_id
WHERE e.term = 'Spring 2026';

