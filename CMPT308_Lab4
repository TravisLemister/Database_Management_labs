--Part A--
Select s.name, e.course_id
From students s
Inner Join enrollments e 
On s.student_id = e.student_id
Where e.term = 'Spring 2026';

Select s.name, c.title, e.term
From students s
Inner Join enrollments e 
	On s.student_id = e.student_id
Inner Join courses c 
	On e.course_id = c.course_id
Where e.term = 'Spring 2026';

Select c.course_id, c.title, Count(e.student_id) As enrollments
From courses c
Left Join enrollments e 
On c.course_id = e.course_id And e.term = 'Spring 2026'
Group By c.course_id, c.title;

--Part B--
Select major, Count(student_id) As num_students
From students
Group By major
Order By num_students DESC;

Select c.course_id, c.title, Count(e.student_id) As num_enrollments
From courses c
Inner Join enrollments e 
  On c.course_id = e.course_id
Where e.term = 'Spring 2026'
Group By c.course_id, c.title;

Select course_id, Count(student_id) As num_enrollments
From enrollments
Where term = 'Spring 2026'
Group By course_id
Having Count (student_id) >= 3;

