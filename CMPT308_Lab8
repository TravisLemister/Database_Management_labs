--Trigger Function--
  CREATE OR REPLACE FUNCTION audit_enrollment_insertion()
    RETURNS TRIGGER AS $$
    BEGIN
      INSERT INTO lab8_enrollment_audit (action_type, student_id, course_id, action_time)
      VALUES ('INSERT', NEW.student_id, NEW.course_id, CURRENT_TIMESTAMP);
    
      RETURN NEW;
   END;
   $$ LANGUAGE plpgsql;

--Create Trigger--
CREATE TRIGGER trg_enrollment_insert
AFTER INSERT ON lab8_enrollments
FOR EACH ROW
EXECUTE FUNCTION audit_enrollment_insertion();

