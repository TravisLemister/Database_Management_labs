SELECT grantee, table_name, privilege_type
FROM information_schema.role_table_grants
WHERE grantee IN ('advisor_role', 'registrar_role')
  AND table_name IN ('lab8_students', 'lab8_courses', 'lab8_enrollments')
ORDER BY grantee, table_name, privilege_type;


--Part B--
CREATE OR REPLACE PROCEDURE register_student(p_sid INT, p_cid TEXT)
LANGUAGE plpgsql AS $$
BEGIN
    IF (SELECT enrolled_count FROM lab8_courses WHERE course_id = p_cid) >= 
       (SELECT capacity FROM lab8_courses WHERE course_id = p_cid) THEN
        RAISE EXCEPTION 'Course is full';
    END IF;

    INSERT INTO lab8_enrollments (student_id, course_id) VALUES (p_sid, p_cid);
    
    UPDATE lab8_courses 
    SET enrolled_count = enrolled_count + 1 
    WHERE course_id = p_cid;
END;
$$;

CALL register_student(101, 'CS101');

CALL register_student(101, 'ART200');
CALL register_student(102, 'ART200');

